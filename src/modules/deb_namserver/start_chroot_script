#!/usr/bin/env bash
# because the builder kept failing to resolve 'deb.debian.org' https://stackoverflow.com/a/51037151
########

# Source error handling, leave this in place
set -xe

# Source CustomPIOS common.sh
# shellcheck disable=SC1091
source /common.sh
install_cleanup_trap

# On the Armbian Trixie base image /etc/resolv.conf is a dangling symlink
# (-> /run/systemd/resolve/stub-resolv.conf), so an append fails with ENOENT
# inside the chroot. Replace it with a real file for the duration of the build.
rm -f /etc/resolv.conf
echo "nameserver 8.8.8.8" > /etc/resolv.conf